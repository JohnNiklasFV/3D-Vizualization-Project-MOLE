  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Objective: Get as many of your moles as possible to the lowest layer to
    win\nMovement: On your turn, select a numbered card (1\u20134) to move one of
    your moles that many spaces.\nStraight Lines: Moles must move in a straight line,
    either horizontally or vertically, and cannot turn corners in a single move.\nHoles:
    If a mole lands in a hole, it drops to the next level down.\nLayer Removal: When
    all holes on a specific layer are occupied by moles, that entire layer is removed
    from the box, taking the moles on top of it with it (leaving the game).\nNo Jumping:
    Moles cannot jump over other moles (yours or opponents').\nForced Move: You must
    move a mole if possible, even if it\u2019s already in a hole."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
